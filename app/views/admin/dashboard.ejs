<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - RevenueIn</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        #sidebar { transition: transform 0.25s ease; }
        #sidebarOverlay { transition: opacity 0.25s ease; }
    </style>
</head>

<body class="bg-gray-50 flex h-screen text-gray-800 overflow-hidden">

    <!-- ── Sidebar Overlay (mobile/tablet) ── -->
    <div id="sidebarOverlay"
        class="fixed inset-0 z-30 bg-black/50 backdrop-blur-sm hidden opacity-0 lg:hidden"
        onclick="closeSidebar()"></div>

    <!-- ── Sidebar ── -->
    <aside id="sidebar"
        class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-slate-900 text-white flex flex-col shrink-0 -translate-x-full lg:translate-x-0">
        <div class="p-6 flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold text-yellow-500">Revenue<span class="text-white">In</span></h2>
                <p class="text-xs text-gray-400 mt-1">Admin Portal</p>
            </div>
            <!-- Close button (mobile/tablet only) -->
            <button onclick="closeSidebar()" class="lg:hidden text-gray-400 hover:text-white p-1">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <nav class="flex-1 px-4 space-y-2 mt-4">
            <a href="/admin"
                class="flex items-center gap-3 px-4 py-3 bg-slate-800 rounded-lg text-sm font-medium hover:bg-slate-700 transition-colors">
                <i class="fas fa-inbox w-5"></i> Messages
            </a>
            <a href="/admin/testimonials"
                class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium hover:bg-slate-700 text-gray-300 transition-colors">
                <i class="fas fa-quote-left w-5"></i> Testimonials
            </a>
        </nav>

        <div class="p-4 border-t border-slate-700">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-full bg-slate-600 flex items-center justify-center shrink-0">
                    <i class="fas fa-user text-sm"></i>
                </div>
                <p class="text-sm font-medium truncate">
                    <%= user ? user.name : 'Admin' %>
                </p>
            </div>
            <a href="/logout"
                class="block w-full text-center px-4 py-2 bg-red-500/10 text-red-500 rounded hover:bg-red-500/20 text-sm transition-colors">
                Logout
            </a>
        </div>
    </aside>

    <!-- ── Main Content ── -->
    <main class="flex-1 overflow-auto flex flex-col min-w-0">

        <!-- Top Header -->
        <header class="bg-white border-b border-gray-200 px-4 sm:px-8 py-4 sm:py-5 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-4">
                <!-- Hamburger (mobile/tablet only) -->
                <button onclick="openSidebar()"
                    class="lg:hidden p-2 rounded-lg hover:bg-gray-100 text-gray-600 transition-colors shrink-0"
                    aria-label="Open menu">
                    <i class="fas fa-bars text-lg"></i>
                </button>
                <div>
                    <h1 class="text-xl sm:text-2xl font-semibold text-gray-800">
                        <%= locals.isArchivedView ? 'Archived Messages' : 'Contact Messages' %>
                    </h1>
                    <p class="text-xs sm:text-sm text-gray-400 mt-0.5">Click on a row to read the full message</p>
                </div>
            </div>
            
            <!-- Archived toggle button -->
            <div>
                <% if (!locals.isArchivedView) { %>
                    <a href="/admin?archived=true" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 sm:px-4 py-2 rounded shadow-sm text-sm font-medium transition-colors border border-gray-300 flex items-center gap-2">
                        <i class="fas fa-archive"></i> <span class="hidden sm:inline">Archived Messages</span>
                    </a>
                <% } else { %>
                    <a href="/admin" class="bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 sm:px-4 py-2 rounded shadow-sm text-sm font-medium transition-colors border border-blue-200 flex items-center gap-2">
                        <i class="fas fa-inbox"></i> <span class="hidden sm:inline">Active Messages</span>
                    </a>
                <% } %>
            </div>
        </header>

        <!-- Content -->
        <div class="p-4 sm:p-8 flex-1">

            <% if (messages && messages.length > 0) { %>

                <!-- Card list (mobile/tablet) -->
                <div class="lg:hidden space-y-3">
                    <% messages.forEach(function(msg) { %>
                        <div class="msg-row bg-white rounded-xl shadow-sm border border-gray-200 p-4 cursor-pointer hover:border-yellow-300 hover:shadow-md transition-all relative"
                            data-name="<%- msg.name %>" data-email="<%- msg.email %>" data-message="<%- msg.message %>" data-id="<%- msg.id %>">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 pr-16">
                                    <p class="font-semibold text-gray-900 text-sm truncate"><%= msg.name %></p>
                                    <p class="text-blue-600 text-xs truncate"><%= msg.email %></p>
                                </div>
                            </div>
                            <p class="text-gray-500 text-xs mt-2 line-clamp-2 pr-12">
                                <%- msg.message.substring(0, 100) %><%= msg.message.length > 100 ? '…' : '' %>
                            </p>
                            <!-- Mobile Actions -->
                            <div class="absolute top-4 right-4 flex flex-col gap-2">
                                <form action="/admin/messages/<%= msg.id %>/archive" method="POST" onclick="event.stopPropagation()">
                                    <button type="submit" class="text-gray-400 hover:text-blue-600 transition p-1" title="<%= locals.isArchivedView ? 'Unarchive' : 'Archive' %>">
                                        <i class="fas <%= locals.isArchivedView ? 'fa-box-open' : 'fa-box' %>"></i>
                                    </button>
                                </form>
                                <form action="/admin/messages/<%= msg.id %>/delete" method="POST" onclick="event.stopPropagation()" onsubmit="return confirm('Are you sure you want to delete this message?')">
                                    <button type="submit" class="text-gray-400 hover:text-red-600 transition p-1" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Table (desktop and up) -->
                <div class="hidden lg:block bg-white rounded-xl shadow-sm border border-gray-200 overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[800px]">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200 text-sm text-gray-500">
                                <th class="py-3 px-6 font-medium">Name</th>
                                <th class="py-3 px-6 font-medium">Email</th>
                                <th class="py-3 px-6 font-medium">Preview</th>
                                <th class="py-3 px-6 font-medium text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            <% messages.forEach(function(msg) { %>
                                <tr class="msg-row border-b border-gray-100 hover:bg-yellow-50/50 cursor-pointer transition-colors"
                                    data-name="<%- msg.name %>" data-email="<%- msg.email %>"
                                    data-message="<%- msg.message %>" data-id="<%- msg.id %>">
                                    <td class="py-4 px-6 font-medium text-gray-800"><%- msg.name %></td>
                                    <td class="py-4 px-6 text-blue-600"><%- msg.email %></td>
                                    <td class="py-4 px-6 text-gray-500 max-w-xs truncate">
                                        <%- msg.message.substring(0, 80) %>
                                        <%= msg.message.length > 80 ? '…' : '' %>
                                    </td>
                                    <td class="py-4 px-6 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <form action="/admin/messages/<%= msg.id %>/archive" method="POST" onclick="event.stopPropagation()">
                                                <button type="submit" class="text-gray-400 hover:text-blue-600 transition p-1.5" title="<%= locals.isArchivedView ? 'Unarchive' : 'Archive' %>">
                                                    <i class="fas <%= locals.isArchivedView ? 'fa-box-open' : 'fa-box' %>"></i>
                                                </button>
                                            </form>
                                            <form action="/admin/messages/<%= msg.id %>/delete" method="POST" onclick="event.stopPropagation()" onsubmit="return confirm('Are you sure you want to delete this message?')">
                                                <button type="submit" class="text-gray-400 hover:text-red-600 transition p-1.5" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            <% } else { %>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center text-gray-500">
                    <i class="fas <%= locals.isArchivedView ? 'fa-box-open' : 'fa-inbox' %> text-4xl mb-3 text-gray-300 block"></i>
                    <p><%= locals.isArchivedView ? 'No archived messages.' : 'No active messages received yet.' %></p>
                </div>
            <% } %>

        </div>
    </main>

    <!-- ── Message Detail Modal ── -->
    <div id="msgModal"
        class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl w-full sm:max-w-lg max-h-[90vh] flex flex-col">
            <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-start shrink-0">
                <div class="min-w-0 pr-4">
                    <h3 id="modalName" class="font-semibold text-lg text-gray-900 truncate"></h3>
                    <a id="modalEmail" href="#" class="text-sm text-blue-600 hover:underline truncate block"></a>
                </div>
                <button id="closeModal"
                    class="text-gray-400 hover:text-gray-600 text-2xl leading-none mt-0.5 shrink-0">&times;</button>
            </div>
            <div class="p-6 overflow-y-auto flex-1">
                <p id="modalMessage" class="text-gray-700 leading-relaxed whitespace-pre-wrap text-sm"></p>
            </div>
            <div class="px-6 pb-5 pt-3 border-t border-gray-100 flex flex-col sm:flex-row gap-3 sm:justify-end shrink-0">
                <form id="modalArchiveForm" method="POST" class="w-full sm:w-auto">
                    <button type="submit" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-center">
                        <i class="fas <%= locals.isArchivedView ? 'fa-box-open' : 'fa-box' %> mr-1.5"></i> <%= locals.isArchivedView ? 'Unarchive' : 'Archive' %>
                    </button>
                </form>
                <form id="modalDeleteForm" method="POST" onsubmit="return confirm('Are you sure you want to delete this message?')" class="w-full sm:w-auto">
                    <button type="submit" class="w-full bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-center">
                        <i class="fas fa-trash mr-1.5"></i> Delete
                    </button>
                </form>
                <a id="modalReply" href="#"
                    class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors text-center">
                    <i class="fas fa-reply mr-1.5"></i> Reply
                </a>
            </div>
        </div>
    </div>

    <script>
        // ── Sidebar (mobile) ──
        function openSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            requestAnimationFrame(() => overlay.classList.remove('opacity-0'));
        }

        function closeSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 250);
        }

        // ── Message Modal ──
        const modal = document.getElementById('msgModal');

        document.querySelectorAll('.msg-row').forEach(function (row) {
            row.addEventListener('click', function () {
                var name = row.getAttribute('data-name');
                var email = row.getAttribute('data-email');
                var message = row.getAttribute('data-message');
                var id = row.getAttribute('data-id');

                document.getElementById('modalName').textContent = name;
                var emailEl = document.getElementById('modalEmail');
                emailEl.textContent = email;
                emailEl.href = 'mailto:' + email;
                document.getElementById('modalMessage').textContent = message;
                document.getElementById('modalReply').href = 'mailto:' + email + '?subject=Re: Your message on RevenueIn';
                
                // Update actions
                document.getElementById('modalArchiveForm').action = '/admin/messages/' + id + '/archive';
                document.getElementById('modalDeleteForm').action = '/admin/messages/' + id + '/delete';

                modal.classList.remove('hidden');
            });
        });

        function closeModal() {
            modal.classList.add('hidden');
        }

        document.getElementById('closeModal').addEventListener('click', closeModal);
        // Removed close modal button and replaced by actions
        modal.addEventListener('click', function (e) {
            if (e.target === modal) closeModal();
        });
    </script>
</body>

</html>